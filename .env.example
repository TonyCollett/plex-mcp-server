# Plex MCP Server Configuration

# Plex Server URL
# Replace localhost with your server's IP address if running remotely
# Default port is usually 32400
PLEX_URL=http://localhost:32400

# Plex Authentication Token
# See instructions in README.md or https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token_here

# Optional: Enable write tools
# Disabled by default for safety. Covers the Plex write tools and the Sonarr,
# Radarr and Trakt tools that change things (adding media, starting searches,
# editing tags, writing history, scrobbling). Set to true to enable.
# PLEX_ENABLE_MUTATIVE_OPS=true

# Optional: Directory export_library writes into (default: ./exports)
# PLEX_EXPORT_DIR=./exports

# Optional: Emit tool responses as TOON instead of JSON
# TOON is a compact, LLM-oriented encoding of the same data — noticeably fewer
# tokens on list-shaped responses. Responses fall back to JSON whenever TOON
# would not be shorter, so this can never make a response larger.
# PLEX_OUTPUT_FORMAT=toon

# Optional: Give up on a Plex request after this many ms (default: 30000)
# PLEX_REQUEST_TIMEOUT_MS=30000

# Optional: Log Plex requests slower than this many ms to stderr (default: 2000)
# PLEX_SLOW_REQUEST_MS=2000

# Optional: Log every Plex request with its timing, not just slow/failed ones
# PLEX_LOG_REQUESTS=true

# Optional: Turn off the one-line-per-tool-call log (on by default)
# MCP_LOG_TOOL_CALLS=false

# ──── HTTP transport (--transport http) ────
# Require "Authorization: Bearer <token>" on every MCP request.
# Strongly recommended whenever the port is reachable from other machines.
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Address to listen on (default: 127.0.0.1; the Docker image uses 0.0.0.0)
# MCP_HOST=127.0.0.1

# Hostnames the endpoint answers to, matched against the Host header.
# Unset on a loopback bind = localhost, 127.0.0.1 and [::1] only.
# MCP_ALLOWED_HOSTS=plex-mcp.example.com,localhost

# Optional: Specify custom port for the MCP server (if needed)
# MCP_PORT=3000

# Optional: URL path the HTTP transport serves MCP on (default: /mcp)
# MCP_PATH=/mcp

# Optional: Enable debug logging
# DEBUG=true

# ──── Sonarr Configuration (for plex-arr-server) ────
# Sonarr URL (default: http://localhost:8989)
# SONARR_URL=http://localhost:8989

# Sonarr API Key
# Find at: Sonarr → Settings → General → API Key
# SONARR_API_KEY=your_sonarr_api_key_here

# ──── Radarr Configuration (for plex-arr-server) ────
# Radarr URL (default: http://localhost:7878)
# RADARR_URL=http://localhost:7878

# Radarr API Key
# Find at: Radarr → Settings → General → API Key
# RADARR_API_KEY=your_radarr_api_key_here

# ──── Trakt Configuration ────
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# File where Trakt tokens are saved after authentication and every refresh,
# and read back on start. Without it, tokens are only logged to stderr.
# TRAKT_TOKEN_FILE=./trakt-tokens.json
